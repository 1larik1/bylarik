<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет: часы и дата (их рисует система, приложение для этого не просыпается),
     статус тревоги и ближайший будильник. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_night"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextClock
            android:id="@+id/w_clock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-light"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="46dp" />

        <TextView
            android:id="@+id/w_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_chip_mint"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:text="@string/widget_preview_status"
            android:textColor="#FF9EF0D6"
            android:textSize="12sp" />
    </LinearLayout>

    <TextClock
        android:id="@+id/w_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:format12Hour="EEEE, d MMMM"
        android:format24Hour="EEEE, d MMMM"
        android:maxLines="1"
        android:textColor="#FFB3A8CC"
        android:textSize="13sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/w_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_w_alarm" />

        <TextView
            android:id="@+id/w_alarm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="07:30"
            android:textColor="#FFF3EEFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/w_tail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_preview_day"
            android:textColor="#FFB3A8CC"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/w_place"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="#FF8E84A8"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
